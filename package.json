    "home:test": "node --import tsx --test tests/home-parity.test.ts",
    "programme:test": "node --import tsx --test tests/programme-domain.test.ts tests/programme-flow.test.ts",
    "programme:migrate": "prisma db execute --schema prisma/schema.prisma --file prisma/preflight/0015_active_control_program_flow.sql && prisma migrate deploy",
    "programme:seed": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed-active-control-program.ts",
