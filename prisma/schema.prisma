  possibleDuplicates    CommercialOpportunity[]      @relation("CommercialOpportunityDuplicates")
  evidence              CommercialEvidence[]
  contacts              CommercialContact[]
  activities            CommercialActivity[]
  applications          CommercialApplication[]
  terms                 CommercialTerm[]
  tasks                 CommercialTask[]
  agentRuns             CommercialAgentRun[]
  agentOperations       CommercialAgentOperation[]
  activationPackets     CommercialActivationPacket[]
  partnerMarketSupports PartnerCasinoMarketSupport[]

