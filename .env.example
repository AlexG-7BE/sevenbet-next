# Local-development placeholders only. Never copy Production values into this file.
# Preview must use a separate non-production database and separate auth/admin secrets.
DATABASE_URL="postgresql://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"
NEXT_PUBLIC_SITE_URL="http://localhost:4173"
ALLOW_TEMPORARY_PRODUCTION_DEMO_CASINOS="false"
PRISMA_INTERACTIVE_TRANSACTION_TIMEOUT_MS=""
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:4173"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:4173"
SEVENBET_ADMIN_PREVIEW_TOKEN="replace-with-a-long-random-token"
CMS_PHASE1_ALLOW_DEV_ADMIN="false"
CMS_AUTH_PROVIDER="placeholder"
CMS_WEBHOOK_SECRET="replace-with-a-long-random-secret"
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_NAME=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_PROFILE_ID=""
ADMIN_PROFILE_EMAIL=""
ADMIN_PROFILE_NAME=""
AFFILIATE_REDIRECT_ENGINE_ENABLED="false"
AFFILIATE_REDIRECT_DEV_GEO_OVERRIDE="false"
# Shadow-only jurisdiction evaluation. Only the literal value "true" enables it.
JURISDICTION_RESOLVER_SHADOW_ENABLED="false"
# Comma-separated logical references. Each reference resolves server-side to
# AFFILIATE_CREDENTIALS_<NORMALIZED_REFERENCE>; never expose those values.
AFFILIATE_CREDENTIAL_REFERENCES=""
PUBLIC_CASINO_CMS_ENABLED="false"
MEDIA_STORAGE_PROVIDER="LOCAL"
MEDIA_LOCAL_STORAGE_ROOT=".media-storage"
MEDIA_PUBLIC_BASE_URL="http://localhost:4173"
MEDIA_MAX_FILE_SIZE_BYTES="10485760"
MEDIA_MAX_DIMENSION="8000"
MEDIA_S3_ENDPOINT=""
MEDIA_S3_REGION="auto"
MEDIA_S3_BUCKET=""
MEDIA_S3_PUBLIC_BASE_URL=""
MEDIA_S3_ACCESS_KEY_ID=""
MEDIA_S3_SECRET_ACCESS_KEY=""
MEDIA_S3_SESSION_TOKEN=""

# Optional operations override. Production smoke otherwise uses its fixed HTTPS origin.
PRODUCTION_SMOKE_BASE_URL=""
