# Local-development placeholders only. Never copy Production values into this file.
# Preview must use a separate non-production database and separate auth/admin secrets.
DATABASE_URL="postgresql://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"
NEXT_PUBLIC_SITE_URL="http://localhost:4173"
ALLOW_TEMPORARY_PRODUCTION_DEMO_CASINOS="false"
PRISMA_INTERACTIVE_TRANSACTION_TIMEOUT_MS=""
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:4173"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:4173"
# Optional Google identity provider. Configure both or the Google option remains unavailable.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Sender identity only. No email provider or Production delivery is selected by this repository.
SEVENBET_ACCOUNT_EMAIL_FROM=""
SEVENBET_PROGRAMME_EMAIL_FROM=""
SEVENBET_EMAIL_REPLY_TO=""
# RFC-028 Contact-only transactional delivery. Exact true plus all three
# server-only values is required; account and Programme delivery stays disabled.
CONTACT_EMAIL_DELIVERY_ENABLED="false"
RESEND_API_KEY=""
CONTACT_EMAIL_FROM="B4GAMBLE <info@b4gamble.com>"
CONTACT_EMAIL_TO="support@b4gamble.com"
SEVENBET_ADMIN_PREVIEW_TOKEN="replace-with-a-long-random-token"
CMS_PHASE1_ALLOW_DEV_ADMIN="false"
CMS_AUTH_PROVIDER="placeholder"
# RFC-022 Preview-only foundation. Missing/malformed values are disabled.
PROGRAM_AI_V1_ENABLED="false"
# RFC-023 real OpenAI provider activation. Preview-only; all values fail closed.
PROGRAM_AI_REAL_PROVIDER_ENABLED="false"
PROGRAM_AI_PROVIDER=""
PROGRAM_AI_OPENAI_MODEL="gpt-5.6-terra"
PROGRAM_AI_TRANSCRIPTION_MODEL="gpt-4o-transcribe"
# Server-only. Never use a NEXT_PUBLIC_ name or commit a real value.
OPENAI_API_KEY=""
CMS_WEBHOOK_SECRET="replace-with-a-long-random-secret"
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_NAME=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_PROFILE_ID=""
ADMIN_PROFILE_EMAIL=""
ADMIN_PROFILE_NAME=""
AFFILIATE_REDIRECT_ENGINE_ENABLED="false"
# Optional bounded diagnostics for obsolete shadow-comparison tests. It is not public authority.
JURISDICTION_RESOLVER_SHADOW_ENABLED="false"
# Comma-separated logical references. Each reference resolves server-side to
# AFFILIATE_CREDENTIALS_<NORMALIZED_REFERENCE>; never expose those values.
AFFILIATE_CREDENTIAL_REFERENCES=""
PUBLIC_CASINO_CMS_ENABLED="false"
# RFC-040 assignment-first public media projection. Exact true only; absent or
# any other value retains the legacy logo/HERO compatibility path.
PLACEMENT_MEDIA_ASSIGNMENTS_ENABLED="false"
# RFC-026 aggregate product analytics is exact opt-in and disabled by default.
# Server-only Bearer secret for the Programme expiry cron. Leave blank locally
# unless explicitly exercising that isolated endpoint.
CRON_SECRET=""
MEDIA_STORAGE_PROVIDER="LOCAL"
MEDIA_LOCAL_STORAGE_ROOT=".media-storage"
MEDIA_PUBLIC_BASE_URL="http://localhost:4173"
MEDIA_MAX_FILE_SIZE_BYTES="10485760"
MEDIA_MAX_DIMENSION="8000"
MEDIA_S3_ENDPOINT=""
MEDIA_S3_REGION="auto"
MEDIA_S3_BUCKET=""
MEDIA_S3_PUBLIC_BASE_URL=""
MEDIA_S3_ACCESS_KEY_ID=""
MEDIA_S3_SECRET_ACCESS_KEY=""
MEDIA_S3_SESSION_TOKEN=""

# Optional operations override. Production smoke otherwise uses its fixed HTTPS origin.
PRODUCTION_SMOKE_BASE_URL=""
