  sourceUrl          String?
  sourceReference    String?
  title              String
  claim              String
  notes              String?
  observedAt         DateTime?
  recordedAt         DateTime                           @default(now())
  expiresAt          DateTime?
  recheckAt          DateTime?
  contentFingerprint String
  idempotencyKey     String
  recordedBy         String

