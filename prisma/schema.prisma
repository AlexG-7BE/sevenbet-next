model AdminUser {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String?   @unique
  email     String    @unique
  name      String
  role      AdminRole @default(AUTHOR)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user                    User?                   @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  auditLogs               AuditLog[]
  activeDayCorrections    ProgrammeActiveDay[]
  commercialOpportunities CommercialOpportunity[] @relation("CommercialOpportunityOwner")
  commercialApplications  CommercialApplication[] @relation("CommercialApplicationOwner")
  commercialTasks         CommercialTask[]        @relation("CommercialTaskOwner")
  commercialActivities    CommercialActivity[]    @relation("CommercialActivityActor")
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions                           Session[]
  accounts                           Account[]
  oauthClients                       OauthClient[]
  oauthRefreshTokens                 OauthRefreshToken[]
  oauthAccessTokens                  OauthAccessToken[]
  oauthConsents                      OauthConsent[]
  adminUser                          AdminUser?
  programEnrollments                 ProgramEnrollment[]
  xpEvents                           UserXpEvent[]
  achievements                       UserAchievement[]
  consumedProgrammeClaims            PendingProgrammeClaim[]
  programmeActiveDays                ProgrammeActiveDay[]
  programmeSensitiveInputAuthorities ProgrammeSensitiveInputAuthority[]
  programmeStartingPoints            ProgrammeStartingPoint[]
  programmeAccessAcceptance          ProgrammeAccessAcceptance?
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]

  @@index([userId])
}

model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([issuer, accountId], map: "account_issuer_accountId_uidx")
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// Additive Better Auth OAuth provider storage used only by the bounded
// Commercial MCP bridge. Consumer and Programme sessions remain unchanged.
model OauthClient {
  id                               String    @id
  clientId                         String    @unique
  clientSecret                     String?
  clientDiscoveryId                String?
  disabled                         Boolean?  @default(false)
  skipConsent                      Boolean?
  enableEndSession                 Boolean?
  subjectType                      String?
  scopes                           String[]
  clientCredentialsScopes          String[]  @default([])
  userId                           String?
  createdAt                        DateTime?
  updatedAt                        DateTime?
  name                             String?
  uri                              String?
  icon                             String?
  contacts                         String[]  @default([])
  tos                              String?
  policy                           String?
  softwareId                       String?
  softwareVersion                  String?
  softwareStatement                String?
  redirectUris                     String[]
  postLogoutRedirectUris           String[]  @default([])
  backchannelLogoutUri             String?
  backchannelLogoutSessionRequired Boolean?
  tokenEndpointAuthMethod          String?
  applicationType                  String?
  jwks                             String?
  jwksUri                          String?
  grantTypes                       String[]
  responseTypes                    String[]
  // Retained temporarily for Better Auth 1.6 rollback compatibility. Better
  // Auth 1.7 uses applicationType and tokenEndpointAuthMethod instead.
  public                           Boolean?
  type                             String?
  requirePKCE                      Boolean?
  dpopBoundAccessTokens            Boolean?  @default(false)
  referenceId                      String?
  metadata                         Json?

  user          User?                 @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  resources     OauthClientResource[]
  refreshTokens OauthRefreshToken[]
  accessTokens  OauthAccessToken[]
  consents      OauthConsent[]

  @@index([userId])
  @@map("oauthClient")
}

model OauthResource {
  id                            String    @id
  identifier                    String    @unique
  name                          String
  accessTokenTtl                Int?
  refreshTokenTtl               Int?
  signingAlgorithm              String?
  signingKeyId                  String?
  allowedScopes                 String[]
  customClaims                  Json?
  dpopBoundAccessTokensRequired Boolean?  @default(false)
  disabled                      Boolean?  @default(false)
  createdAt                     DateTime?
  updatedAt                     DateTime?
  policyVersion                 Int?      @default(1)
  metadata                      Json?

  clients OauthClientResource[]

  @@map("oauthResource")
}

model OauthClientResource {
  id         String    @id
  clientId   String
  resourceId String
  metadata   Json?
  createdAt  DateTime?

  client   OauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade, onUpdate: Cascade)
  resource OauthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade, onUpdate: Cascade)

  @@unique([clientId, resourceId], map: "oauthClientResource_clientId_resourceId_uidx")
  @@index([clientId])
  @@index([resourceId])
  @@map("oauthClientResource")
}

model OauthRefreshToken {
  id                      String    @id
  token                   String    @unique
  clientId                String
  sessionId               String?
  userId                  String
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]
  requestedUserInfoClaims String[]  @default([])
  expiresAt               DateTime
  createdAt               DateTime
  revoked                 DateTime?
  rotatedAt               DateTime?
  rotationReplayResponse  String?
  rotationReplayExpiresAt DateTime?
  authTime                DateTime?
  confirmation            Json?
  scopes                  String[]

  client       OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade, onUpdate: Cascade)
  session      Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  accessTokens OauthAccessToken[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@map("oauthRefreshToken")
}

model OauthAccessToken {
  id                      String    @id
  token                   String    @unique
  clientId                String
  sessionId               String?
  userId                  String?
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]
  requestedUserInfoClaims String[]  @default([])
  refreshId               String?
  expiresAt               DateTime
  createdAt               DateTime
  revoked                 DateTime?
  confirmation            Json?
  scopes                  String[]

  client       OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade, onUpdate: Cascade)
  session      Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  user         User?              @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  refreshToken OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@index([refreshId])
  @@map("oauthAccessToken")
}

model OauthConsent {
  id                      String   @id
  clientId                String
  userId                  String?
  referenceId             String?
  resources               String[]
  requestedUserInfoClaims String[] @default([])
  scopes                  String[]
  createdAt               DateTime
  updatedAt               DateTime

  client OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade, onUpdate: Cascade)
  user   User?       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([clientId])
  @@index([userId])
  @@map("oauthConsent")
}

model OauthClientAssertion {
  id        String   @id
  expiresAt DateTime

  @@map("oauthClientAssertion")
}

// Hashed fixed-window counters for the public Commercial MCP boundary. Raw IP,
// staff and OAuth client identifiers are never stored in this table.
model CommercialMcpRateLimitBucket {
  bucketKey       String   @id
  scope           String
  count           Int
  windowStartedAt DateTime
  expiresAt       DateTime

  @@index([expiresAt])
}

model Program {
  id                           String          @id @default(uuid()) @db.Uuid
  slug                         String          @unique
  internalName                 String
  title                        String
  summary                      String
  introduction                 String
  estimatedTotalMinutes        Int
  language                     String          @default("en")
  difficulty                   String          @default("Beginner")
  coverImage                   String?
  xpCompletionReward           Int             @default(0)
  certificateEnabled           Boolean         @default(false)
  registrationRequirementPoint String          @default("NEVER")
  progressSavingBehavior       String          @default("LOCAL")
  completionRules              Json
  seoTitle                     String?
  seoDescription               String?
  socialImage                  String?
  canonicalUrl                 String?
  publishedVersion             Int             @default(0)
  draftVersion                 Int             @default(1)
  publishedAt                  DateTime?
  scheduledPublishAt           DateTime?
  status                       EditorialStatus @default(DRAFT)
  archivedAt                   DateTime?
  createdAt                    DateTime        @default(now())
  updatedAt                    DateTime        @updatedAt
  createdBy                    String
  updatedBy                    String

  steps       ProgramStep[]
  versions    ProgramVersion[]
  enrollments ProgramEnrollment[]
  xpEvents    UserXpEvent[]
}

model ProgramStep {
  id                 String          @id @default(uuid()) @db.Uuid
  programId          String          @db.Uuid
  slug               String          @unique
  title              String
  shortTitle         String
  description        String
  learningObjective  String
  status             EditorialStatus @default(DRAFT)
  order              Int
  estimatedMinutes   Int
  xp                 Int             @default(0)
  completionMessage  String
  practicalTakeaway  String
  prerequisites      Json
  icon               String?
  visibility         String          @default("PUBLIC")
  unlockDelayHours   Int?
  relatedGuideIds    String[]
  relatedResourceIds String[]
  completionRules    Json
  archivedAt         DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  createdBy          String
  updatedBy          String

  program Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([programId, order])
}

model Lesson {
  id                        String          @id @default(uuid()) @db.Uuid
  programStepId             String          @db.Uuid
  slug                      String          @unique
  title                     String
  summary                   String
  objective                 String
  status                    EditorialStatus @default(DRAFT)
  order                     Int
  estimatedMinutes          Int
  xp                        Int             @default(0)
  required                  Boolean         @default(true)
  retryPolicy               String          @default("UNLIMITED")
  prerequisites             Json
  completionRules           Json
  takeaway                  String
  recap                     String[]
  relatedResourceIds        String[]
  allowCommercialReferences Boolean         @default(false)
  archivedAt                DateTime?
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
  createdBy                 String
  updatedBy                 String

  programStep ProgramStep   @relation(fields: [programStepId], references: [id], onDelete: Cascade)
  blocks      LessonBlock[]
}

model LessonBlock {
  id            String       @id @default(uuid()) @db.Uuid
  lessonId      String       @db.Uuid
  type          CmsBlockType
  order         Int
  internalLabel String
  required      Boolean      @default(false)
  archived      Boolean      @default(false)
  data          Json

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId, order])
}

model ProgramVersion {
  id           String    @id @default(uuid()) @db.Uuid
  programId    String    @db.Uuid
  version      Int
  status       String
  snapshot     Json
  migrationMap Json?
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  createdBy    String

  program     Program             @relation(fields: [programId], references: [id], onDelete: Cascade)
  enrollments ProgramEnrollment[]

  @@unique([programId, version])
  @@index([programId, createdAt])
}

model ProgramEnrollment {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String
  programId        String    @db.Uuid
  programVersionId String    @db.Uuid
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  currentStepId    String?   @db.Uuid
  timezone         String    @default("UTC")

  program                Program                    @relation(fields: [programId], references: [id], onDelete: Restrict)
  programVersion         ProgramVersion             @relation(fields: [programVersionId], references: [id], onDelete: Restrict)
  user                   User                       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  progressEvents         ProgramProgressEvent[]
  reflections            ProgramReflection[]
  missionProgress        ProgrammeMissionProgress[]
  momentMap              MomentMap?
  currentGoal            CurrentGoal?
  urgeLearningRecord     UrgeLearningRecord?
  activeBoundary         ActiveBoundary?
  activeDays             ProgrammeActiveDay[]
  programmeStartingPoint ProgrammeStartingPoint?

  @@unique([userId, programId])
  @@index([programVersionId])
}

/// Private participant-authored text. This is deliberately separate from the
/// event ledger so progress queries, rewards, and operational analytics never
/// need to read reflection content.
model ProgramReflection {
  id           String   @id @default(uuid()) @db.Uuid
  enrollmentId String   @db.Uuid
  blockId      String   @db.Uuid
  content      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  enrollment ProgramEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, blockId])
  @@index([enrollmentId, updatedAt])
}

model ProgramProgressEvent {
  id           String   @id @default(uuid()) @db.Uuid
  enrollmentId String   @db.Uuid
  entityId     String
  entityType   String
  eventType    String
  eventKey     String
  metadata     Json?
  createdAt    DateTime @default(now())

  enrollment ProgramEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, eventKey])
  @@index([enrollmentId, createdAt])
}

model XpRule {
  id             String          @id @default(uuid()) @db.Uuid
  slug           String          @unique
  title          String
  eventType      XpEventType
  targetId       String?
  xp             Int
  active         Boolean         @default(true)
  effectiveStart DateTime?
  effectiveEnd   DateTime?
  awardKey       String          @unique
  status         EditorialStatus @default(DRAFT)
  archivedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  createdBy      String
  updatedBy      String

  userXpEvents UserXpEvent[]
}

model UserXpEvent {
  id                 String      @id @default(uuid()) @db.Uuid
  userId             String
  ruleId             String?     @db.Uuid
  achievementId      String?     @db.Uuid
  programId          String?     @db.Uuid
  missionNumber      Int?
  sourceArtifactType String?
  sourceArtifactId   String?     @db.Uuid
  awardKey           String
  eventType          XpEventType
  xp                 Int
  createdAt          DateTime    @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  rule        XpRule?      @relation(fields: [ruleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  achievement Achievement? @relation(fields: [achievementId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  program     Program?     @relation(fields: [programId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([userId, awardKey])
  @@index([userId, createdAt])
  @@index([ruleId])
  @@index([achievementId])
  @@index([programId, missionNumber])
}

/// Short-lived private state for Mission 01. The opaque browser token is
/// stored only as a hash; draft content is never copied to progress events.
model AnonymousProgrammeSession {
  id              String                 @id @default(uuid()) @db.Uuid
  tokenHash       String                 @unique
  missionState    ProgrammeMissionStatus @default(NOT_STARTED)
  taskStates      String[]
  draft           Json?
  missionVersion  String
  evidenceVersion String
  expiresAt       DateTime
  lastActivityAt  DateTime               @default(now())
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  deletedAt       DateTime?

  pendingClaim              PendingProgrammeClaim?
  sensitiveInputAuthorities ProgrammeSensitiveInputAuthority[]
  programmeAccessAcceptance ProgrammeAccessAcceptance?

  @@index([expiresAt])
}

enum ProgrammeAccessAcceptanceSource {
  DIRECT_AUTHENTICATED
  ANONYMOUS_JOURNEY
  PROGRAM_AI_CLAIM_BACKFILL
}

/// Durable, purpose-specific evidence that the Programme entry requirements
/// were affirmed once. This is not date-of-birth or KYC evidence, cannot be
/// withdrawn by normal session lifecycle, and is never a commercial signal.
model ProgrammeAccessAcceptance {
  id                         String                          @id @default(uuid()) @db.Uuid
  userId                     String?                         @unique
  anonymousSessionId         String?                         @unique @db.Uuid
  adultSelfAttestedAt        DateTime
  termsAcceptedAt            DateTime
  privacyAcknowledgedAt      DateTime
  termsVersionAtAcceptance   String?
  privacyVersionAtAcceptance String?
  source                     ProgrammeAccessAcceptanceSource
  createdAt                  DateTime                        @default(now())
  updatedAt                  DateTime                        @updatedAt

  user             User?                      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  anonymousSession AnonymousProgrammeSession? @relation(fields: [anonymousSessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([source, createdAt])
}

/// Transient distributed fixed-window counters. bucketKey is a one-way HMAC
/// digest and intentionally has no relation to a user or Programme session.
model ProgrammeRuntimeRateLimitBucket {
  bucketKey       String   @id @db.Char(64)
  scope           String   @db.VarChar(64)
  count           Int
  windowStartedAt DateTime
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([expiresAt])
}

/// Minimum evidence for the narrow authority required before processing
/// unrestricted voluntarily supplied health/addiction information. This is
/// purpose-separated from Programme access, Terms, Privacy and marketing.
model ProgrammeSensitiveInputAuthority {
  id                 String    @id @default(uuid()) @db.Uuid
  anonymousSessionId String?   @db.Uuid
  userId             String?
  purposeVersion     String
  statementVersion   String
  confirmedAt        DateTime
  withdrawnAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  anonymousSession AnonymousProgrammeSession? @relation(fields: [anonymousSessionId], references: [id], onDelete: Cascade)
  user             User?                      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([anonymousSessionId, purposeVersion, statementVersion])
  @@unique([userId, purposeVersion, statementVersion])
  @@index([anonymousSessionId, withdrawnAt])
  @@index([userId, withdrawnAt])
}

/// One-time bridge between the anonymous Mission 01 result and the Better
/// Auth account that elects to save it.
model PendingProgrammeClaim {
  id                 String    @id @default(uuid()) @db.Uuid
  anonymousSessionId String    @unique @db.Uuid
  tokenHash          String    @unique
  expiresAt          DateTime
  consumedAt         DateTime?
  consumedByUserId   String?
  createdAt          DateTime  @default(now())

  anonymousSession AnonymousProgrammeSession @relation(fields: [anonymousSessionId], references: [id], onDelete: Cascade)
  consumedByUser   User?                     @relation(fields: [consumedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([expiresAt, consumedAt])
  @@index([consumedByUserId])
}

model ProgrammeMissionProgress {
