model CommercialOpportunity {
  id                     String                     @id @default(uuid()) @db.Uuid
  displayName            String
  normalizedName         String
  legalName              String?
  organizationType       CommercialOrganizationType @default(OTHER)
  stage                  CommercialOpportunityStage @default(PROSPECT)
  priority               CommercialPriority         @default(MEDIUM)
  waitingOn              CommercialWaitingOn        @default(NONE)
  ownerId                String?                    @db.Uuid
  strategicFit           String?
  marketRelevance        String?
  productFit             String?
  integrationBurden      String?
  qualificationRationale String?
  commercialNotes        String?
  riskNotes              String?
  nextActionSummary      String?
  nextActionDueAt        DateTime?
  operatorId             String?                    @db.Uuid
  brandId                String?                    @db.Uuid
  casinoId               String?                    @db.Uuid
  affiliateNetworkId     String?                    @db.Uuid
  affiliateProgramId     String?                    @db.Uuid
  possibleDuplicateOfId  String?                    @db.Uuid
  creationIdempotencyKey String?                    @unique
  createdBy              String
  updatedBy              String
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  owner                 AdminUser?                   @relation("CommercialOpportunityOwner", fields: [ownerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  operator              CasinoOperator?              @relation(fields: [operatorId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  brand                 CasinoBrand?                 @relation(fields: [brandId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  casino                Casino?                      @relation(fields: [casinoId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  affiliateNetwork      AffiliateNetwork?            @relation(fields: [affiliateNetworkId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  affiliateProgram      AffiliateProgram?            @relation(fields: [affiliateProgramId], references: [id], onDelete: SetNull, onUpdate: Cascade)
