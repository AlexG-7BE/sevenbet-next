generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EditorialStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

// Editorial review state is intentionally separate from the legacy casino
// workflow: a casino may remain operational while its public review is held.
enum EditorialReviewStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  ARCHIVED
  SUSPENDED
}

enum OfferStatus {
  DRAFT
  ACTIVE
  PAUSED
  EXPIRED
  ARCHIVED
}

enum CasinoImageKind {
  LOGO
  ICON
  HERO
  SCREENSHOT
  OTHER
}

enum MediaAssetType {
  LOGO
  FAVICON
  HERO
  SCREENSHOT
  GALLERY
  BONUS_CREATIVE
  SOCIAL_IMAGE
  AFFILIATE_CREATIVE
  OTHER
}

enum MediaStorageProvider {
  LOCAL
  S3
}

enum MediaAssetStatus {
  PROCESSING
  ACTIVE
  ARCHIVED
  FAILED
  STORAGE_DELETE_FAILED
}

enum CasinoCountryAvailability {
  AVAILABLE
  RESTRICTED
  NOT_AVAILABLE
  UNKNOWN
}

// Additive governed-domain states. Nullable fields using these enums preserve
// the legacy CMS lifecycle until an explicit migration command assigns them.
enum CasinoPublicationStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  SUSPENDED
  ARCHIVED
}

enum CasinoLifecycleStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
  UNKNOWN
}

enum CasinoLicenceStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
  REVOKED
  UNKNOWN
}

enum CasinoLicenceEvidenceStatus {
  VERIFIED
  UNVERIFIED
  EXPIRED
  REJECTED
  UNKNOWN
}

enum CasinoBonusType {
  WELCOME
  NO_DEPOSIT
  FREE_SPINS
  RELOAD
  CASHBACK
  VIP
  OTHER
}

enum CasinoAffiliateLinkType {
  OFFER
  OFFICIAL_SITE
  TERMS
  SUPPORT
  OTHER
}

enum AffiliateNetworkType {
  EVERFLOW
  INCOME_ACCESS
  MYAFFILIATES
  NETREFER
  DIRECT
  OTHER
}

enum AffiliateStatus {
  DRAFT
  ACTIVE
  PAUSED
  EXPIRED
  ARCHIVED
}

enum AffiliatePayoutModel {
  CPA
  CPL
  REV_SHARE
  HYBRID
  FLAT
  UNKNOWN
}

enum AffiliateGeoMode {
  GLOBAL
  ALLOW
  BLOCK
}

enum AffiliateConnectionStatus {
  DISCONNECTED
  CONFIGURED
  CONNECTED
  ERROR
}

enum AffiliateIntegrationMode {
  MANUAL
  API
  CSV
  JSON
  XML
  SFTP
  WEBHOOK
}

enum AffiliateSyncMode {
  FULL
  INCREMENTAL
}

enum AffiliateImportStatus {
  PENDING
  RUNNING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
  CANCELLED
}

enum AffiliateImportAction {
  CREATE
  UPDATE
  NO_CHANGE
  ARCHIVE
  SKIP
  CONFLICT
  ERROR
}

enum AffiliateImportItemStatus {
  PENDING
  APPLIED
  SKIPPED
  FAILED
}

enum AffiliateExternalEntityType {
  PROGRAM
  CASINO
  OFFER
  TRACKING_LINK
  BONUS
  CREATIVE
}

enum AffiliateMatchStatus {
  MATCHED
  UNMATCHED
  REVIEW_REQUIRED
  IGNORED
  CONFLICT
}

enum AffiliateMatchMethod {
  EXTERNAL_MAPPING
  DOMAIN
  BRAND
  ALIAS
  MANUAL
}

enum AffiliateSourcePolicy {
  MANUAL_WINS
  PROVIDER_WINS
  PROVIDER_IF_EMPTY
  REVIEW_ON_CONFLICT
}

enum CasinoAliasType {
  BRAND
  DOMAIN
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  AUTHOR
  REVIEWER
  AFFILIATE_MANAGER
  ANALYST
  SUPPORT
}

enum CmsBlockType {
  TEXT
  HEADING
  CALLOUT
  IMAGE
  VIDEO
  QUOTE
  CHECKLIST
  QUIZ
  SCENARIO
  EXERCISE
  REFLECTION
  PRACTICAL_TASK
  RESOURCE_LINK
  SUMMARY
  DIVIDER
  RESPONSIBLE_GAMBLING_NOTICE
  RELATED_COMPARISON
}

enum XpEventType {
  LESSON_COMPLETION
  STEP_COMPLETION
  QUIZ_COMPLETION
  QUIZ_PASSING
  SCENARIO_COMPLETION
  EXERCISE_COMPLETION
  PROGRAM_COMPLETION
  GUIDE_COMPLETION
  MISSION_COMPLETION
}

enum ProgrammeMissionStatus {
  NOT_STARTED
  IN_PROGRESS
  READY_TO_SAVE
  REGISTRATION_REQUIRED
  COMPLETED
}

enum GoalDirection {
  UNDERSTAND
  PAUSE
  REDUCE_IMPULSE
  SET_BOUNDARY
  RESEARCH_LATER
  SEEK_SUPPORT
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  PAUSED
}

enum EarlySignalCategory {
  BODY
  THOUGHT
  ATTENTION
  ACTION_TENDENCY
  NOT_SURE
}

enum BoundaryCategory {
  MONEY
  TIME
  ACCESS
  PAUSE
}

enum BoundaryStatus {
  ACTIVE
  PAUSED
  RETIRED
}

model AdminUser {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String?   @unique
  email     String    @unique
  name      String
  role      AdminRole @default(AUTHOR)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user                 User?                @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  auditLogs            AuditLog[]
  activeDayCorrections ProgrammeActiveDay[]
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions                Session[]
  accounts                Account[]
  adminUser               AdminUser?
  programEnrollments      ProgramEnrollment[]
  xpEvents                UserXpEvent[]
  achievements            UserAchievement[]
  consumedProgrammeClaims PendingProgrammeClaim[]
  programmeActiveDays     ProgrammeActiveDay[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Program {
  id                           String          @id @default(uuid()) @db.Uuid
  slug                         String          @unique
  internalName                 String
  title                        String
  summary                      String
  introduction                 String
  estimatedTotalMinutes        Int
  language                     String          @default("en")
  difficulty                   String          @default("Beginner")
  coverImage                   String?
  xpCompletionReward           Int             @default(0)
  certificateEnabled           Boolean         @default(false)
  registrationRequirementPoint String          @default("NEVER")
  progressSavingBehavior       String          @default("LOCAL")
  completionRules              Json
  seoTitle                     String?
  seoDescription               String?
  socialImage                  String?
  canonicalUrl                 String?
  publishedVersion             Int             @default(0)
  draftVersion                 Int             @default(1)
  publishedAt                  DateTime?
  scheduledPublishAt           DateTime?
  status                       EditorialStatus @default(DRAFT)
  archivedAt                   DateTime?
  createdAt                    DateTime        @default(now())
  updatedAt                    DateTime        @updatedAt
  createdBy                    String
  updatedBy                    String

  steps       ProgramStep[]
  versions    ProgramVersion[]
  enrollments ProgramEnrollment[]
  xpEvents    UserXpEvent[]
}

model ProgramStep {
  id                 String          @id @default(uuid()) @db.Uuid
  programId          String          @db.Uuid
  slug               String          @unique
  title              String
  shortTitle         String
  description        String
  learningObjective  String
  status             EditorialStatus @default(DRAFT)
  order              Int
  estimatedMinutes   Int
  xp                 Int             @default(0)
  completionMessage  String
  practicalTakeaway  String
  prerequisites      Json
  icon               String?
  visibility         String          @default("PUBLIC")
  unlockDelayHours   Int?
  relatedGuideIds    String[]
  relatedResourceIds String[]
  completionRules    Json
  archivedAt         DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  createdBy          String
  updatedBy          String

  program Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([programId, order])
}

model Lesson {
  id                        String          @id @default(uuid()) @db.Uuid
  programStepId             String          @db.Uuid
  slug                      String          @unique
  title                     String
  summary                   String
  objective                 String
  status                    EditorialStatus @default(DRAFT)
  order                     Int
  estimatedMinutes          Int
  xp                        Int             @default(0)
  required                  Boolean         @default(true)
  retryPolicy               String          @default("UNLIMITED")
  prerequisites             Json
  completionRules           Json
  takeaway                  String
  recap                     String[]
  relatedResourceIds        String[]
  allowCommercialReferences Boolean         @default(false)
  archivedAt                DateTime?
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
  createdBy                 String
  updatedBy                 String

  programStep ProgramStep   @relation(fields: [programStepId], references: [id], onDelete: Cascade)
  blocks      LessonBlock[]
}

model LessonBlock {
  id            String       @id @default(uuid()) @db.Uuid
  lessonId      String       @db.Uuid
  type          CmsBlockType
  order         Int
  internalLabel String
  required      Boolean      @default(false)
  archived      Boolean      @default(false)
  data          Json

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId, order])
}

model ProgramVersion {
  id           String    @id @default(uuid()) @db.Uuid
  programId    String    @db.Uuid
  version      Int
  status       String
  snapshot     Json
  migrationMap Json?
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  createdBy    String

  program     Program             @relation(fields: [programId], references: [id], onDelete: Cascade)
  enrollments ProgramEnrollment[]

  @@unique([programId, version])
  @@index([programId, createdAt])
}

model ProgramEnrollment {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String
  programId        String    @db.Uuid
  programVersionId String    @db.Uuid
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  currentStepId    String?   @db.Uuid
  timezone         String    @default("UTC")

  program            Program                    @relation(fields: [programId], references: [id], onDelete: Restrict)
  programVersion     ProgramVersion             @relation(fields: [programVersionId], references: [id], onDelete: Restrict)
  user               User                       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  progressEvents     ProgramProgressEvent[]
  reflections        ProgramReflection[]
  missionProgress    ProgrammeMissionProgress[]
  momentMap          MomentMap?
  currentGoal        CurrentGoal?
  urgeLearningRecord UrgeLearningRecord?
  activeBoundary     ActiveBoundary?
  activeDays         ProgrammeActiveDay[]

  @@unique([userId, programId])
  @@index([programVersionId])
}

/// Private participant-authored text. This is deliberately separate from the
/// event ledger so progress queries, rewards, and operational analytics never
/// need to read reflection content.
model ProgramReflection {
  id           String   @id @default(uuid()) @db.Uuid
  enrollmentId String   @db.Uuid
  blockId      String   @db.Uuid
  content      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  enrollment ProgramEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, blockId])
  @@index([enrollmentId, updatedAt])
}

model ProgramProgressEvent {
  id           String   @id @default(uuid()) @db.Uuid
  enrollmentId String   @db.Uuid
  entityId     String
  entityType   String
  eventType    String
  eventKey     String
  metadata     Json?
  createdAt    DateTime @default(now())

  enrollment ProgramEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, eventKey])
  @@index([enrollmentId, createdAt])
}

model XpRule {
  id             String          @id @default(uuid()) @db.Uuid
  slug           String          @unique
  title          String
  eventType      XpEventType
  targetId       String?
  xp             Int
  active         Boolean         @default(true)
  effectiveStart DateTime?
  effectiveEnd   DateTime?
  awardKey       String          @unique
  status         EditorialStatus @default(DRAFT)
  archivedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  createdBy      String
  updatedBy      String

  userXpEvents UserXpEvent[]
}

model UserXpEvent {
  id                 String      @id @default(uuid()) @db.Uuid
  userId             String
  ruleId             String?     @db.Uuid
  achievementId      String?     @db.Uuid
  programId          String?     @db.Uuid
  missionNumber      Int?
  sourceArtifactType String?
  sourceArtifactId   String?     @db.Uuid
  awardKey           String
  eventType          XpEventType
  xp                 Int
  createdAt          DateTime    @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  rule        XpRule?      @relation(fields: [ruleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  achievement Achievement? @relation(fields: [achievementId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  program     Program?     @relation(fields: [programId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([userId, awardKey])
  @@index([userId, createdAt])
  @@index([ruleId])
  @@index([achievementId])
  @@index([programId, missionNumber])
}

/// Short-lived private state for Mission 01. The opaque browser token is
/// stored only as a hash; draft content is never copied to progress events.
model AnonymousProgrammeSession {
  id              String                 @id @default(uuid()) @db.Uuid
  tokenHash       String                 @unique
  missionState    ProgrammeMissionStatus @default(NOT_STARTED)
  taskStates      String[]
  draft           Json?
  missionVersion  String
  evidenceVersion String
  expiresAt       DateTime
  lastActivityAt  DateTime               @default(now())
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  deletedAt       DateTime?

  pendingClaim PendingProgrammeClaim?

  @@index([expiresAt])
}

/// One-time bridge between the anonymous Mission 01 result and the Better
/// Auth account that elects to save it.
model PendingProgrammeClaim {
  id                 String    @id @default(uuid()) @db.Uuid
  anonymousSessionId String    @unique @db.Uuid
  tokenHash          String    @unique
  expiresAt          DateTime
  consumedAt         DateTime?
  consumedByUserId   String?
  createdAt          DateTime  @default(now())

  anonymousSession AnonymousProgrammeSession @relation(fields: [anonymousSessionId], references: [id], onDelete: Cascade)
  consumedByUser   User?                     @relation(fields: [consumedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([expiresAt, consumedAt])
  @@index([consumedByUserId])
}

model ProgrammeMissionProgress {
  id            String                 @id @default(uuid()) @db.Uuid
  enrollmentId  String                 @db.Uuid
  missionNumber Int
  status        ProgrammeMissionStatus @default(NOT_STARTED)
  taskStates    String[]
  draft         Json?
  completedAt   DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  enrollment ProgramEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, missionNumber])
  @@index([enrollmentId, updatedAt])
}

model MomentMap {
  id                   String    @id @default(uuid()) @db.Uuid
  enrollmentId         String    @unique @db.Uuid
  situation            String
  cues                 String[]
  thoughtOrFeeling     String
  response             String
  immediateConsequence String
  noticeRule           String
  neutralFlags         String[]
  notSureFlags         String[]
  missionVersion       String
  evidenceVersion      String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  enrollment   ProgramEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  sourcedGoals CurrentGoal[]
}

model CurrentGoal {
  id                   String        @id @default(uuid()) @db.Uuid
  enrollmentId         String        @unique @db.Uuid
  sourceMomentMapId    String        @db.Uuid
  direction            GoalDirection
  action               String
  triggerOrSituation   String
  alternativeAction    String
  successSignal        String
  reviewAt             DateTime
  confidence           Int
  confidenceAdjustment String
  status               GoalStatus    @default(ACTIVE)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  deletedAt            DateTime?

  enrollment        ProgramEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  sourceMomentMap   MomentMap         @relation(fields: [sourceMomentMapId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sourcedBoundaries ActiveBoundary[]

  @@index([sourceMomentMapId])
}

/// Private Mission 03 learning record. Personal signal text stays inside the
/// Programme aggregate and is never copied to event or reward ledgers.
model UrgeLearningRecord {
  id                       String               @id @default(uuid()) @db.Uuid
  enrollmentId             String               @unique @db.Uuid
  missionVersion           String
  learningItemId           String
  evidenceVersion          String
  reviewedAt               DateTime
  scenarioCheckCompletedAt DateTime
  meaningCheckCompletedAt  DateTime
  earlySignalCategory      EarlySignalCategory?
  earlySignalText          String?
  notNow                   Boolean              @default(false)
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  deletedAt                DateTime?

  enrollment        ProgramEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  sourcedBoundaries ActiveBoundary[]
}

/// Private Mission 04 rule. User-entered values and free text remain inside
/// the Programme aggregate and never enter commercial ranking or targeting.
model ActiveBoundary {
  id                         String           @id @default(uuid()) @db.Uuid
  enrollmentId               String           @unique @db.Uuid
  sourceCurrentGoalId        String?          @db.Uuid
  sourceUrgeLearningRecordId String?          @db.Uuid
  missionVersion             String
  evidenceVersion            String
  category                   BoundaryCategory
  triggerType                String
  triggerText                String?
  ruleText                   String
  limitValue                 Decimal?         @db.Decimal(12, 2)
  limitUnit                  String?
  limitPeriod                String?
  executionMethod            String
  executionDetail            String?
  copingAction               String
  reviewAt                   DateTime
  status                     BoundaryStatus   @default(ACTIVE)
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt
  deletedAt                  DateTime?

  enrollment               ProgramEnrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  sourceCurrentGoal        CurrentGoal?        @relation(fields: [sourceCurrentGoalId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  sourceUrgeLearningRecord UrgeLearningRecord? @relation(fields: [sourceUrgeLearningRecordId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([sourceCurrentGoalId])
  @@index([sourceUrgeLearningRecordId])
}

/// One eligible programme day per user-local date. Voiding preserves the
/// correction trail without rewriting XP or sensitive artefacts.
model ProgrammeActiveDay {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String
  enrollmentId       String    @db.Uuid
  localDate          DateTime  @db.Date
  timezone           String
  sourceEventKey     String
  eligibleActivityAt DateTime
  createdAt          DateTime  @default(now())
  voidedAt           DateTime?
  voidReason         String?
  voidedByAdminId    String?   @db.Uuid

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  enrollment    ProgramEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  voidedByAdmin AdminUser?        @relation(fields: [voidedByAdminId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([userId, localDate])
  @@unique([enrollmentId, sourceEventKey])
  @@index([userId, localDate, voidedAt])
  @@index([voidedByAdminId])
}

model Achievement {
  id             String          @id @default(uuid()) @db.Uuid
  slug           String          @unique
  internalName   String          @unique
  title          String
  description    String
  icon           String
  category       String
  tier           String
  xpReward       Int             @default(0)
  active         Boolean         @default(true)
  hidden         Boolean         @default(false)
  triggerType    String
  triggerConfig  Json
  effectiveStart DateTime?
  effectiveEnd   DateTime?
  status         EditorialStatus @default(DRAFT)
  archivedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  createdBy      String
  updatedBy      String

  userAchievements UserAchievement[]
  xpEvents         UserXpEvent[]
}

model UserAchievement {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String
  achievementId String   @db.Uuid
  awardKey      String
  awardedAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([userId, awardKey])
  @@index([userId, awardedAt])
  @@index([achievementId])
}

model Article {
  id             String          @id @default(uuid()) @db.Uuid
  slug           String          @unique
  title          String
  excerpt        String
  category       String
  tags           String[]
  status         EditorialStatus @default(DRAFT)
  bodyBlocks     Json
  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?
  readingTime    String?
  difficulty     String?
  publishedAt    DateTime?
  lastReviewedAt DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  createdBy      String
  updatedBy      String
}

model Casino {
  id                          String                   @id @default(uuid()) @db.Uuid
  slug                        String                   @unique
  internalName                String?
  title                       String
  domain                      String                   @unique
  websiteUrl                  String?
  operator                    String?
  operatorProfileId           String?                  @db.Uuid
  brandProfileId              String?                  @db.Uuid
  domainLifecycleStatus       CasinoLifecycleStatus?
  domainPublicationStatus     CasinoPublicationStatus?
  responsibleGamblingMetadata Json?
  trackingMetadata            Json?
  tagline                     String?
  summary                     String?
  description                 String?
  foundedYear                 Int?
  language                    String                   @default("en")
  languages                   String[]                 @default([])
  currencies                  String[]                 @default([])
  editorScore                 Float?
  license                     String?
  country                     String?
  pros                        String[]                 @default([])
  cons                        String[]                 @default([])
  responsibleGamblingTools    String[]                 @default([])
  reviewBlocks                Json?
  status                      EditorialStatus          @default(DRAFT)
  publishedVersion            Int                      @default(0)
  draftVersion                Int                      @default(1)
  publishedAt                 DateTime?
  scheduledPublishAt          DateTime?
  lastReviewedAt              DateTime?
  archivedAt                  DateTime?
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt
  createdBy                   String
  updatedBy                   String

  bonuses           Bonus[]
  affiliateLinks    AffiliateLink[]
  versions          CasinoVersion[]
  revisions         CasinoRevision[]
  images            CasinoImage[]
  mediaAssets       MediaAsset[]
  countries         CasinoCountry[]
  licenses          CasinoLicense[]
  paymentMethods    CasinoPaymentMethod[]
  gameProviders     CasinoGameProvider[]
  gameCategories    CasinoGameCategory[]
  casinoBonuses     CasinoBonus[]
  casinoLinks       CasinoAffiliateLink[]
  affiliateOffers   AffiliateOffer[]
  affiliatePrograms AffiliateProgram[]
  redirectSlugs     AffiliateRedirectSlug[]
  aliases           CasinoAlias[]
  seo               CasinoSeo?
  editorialReview   EditorialReview?
  operatorProfile   CasinoOperator?         @relation(fields: [operatorProfileId], references: [id], onDelete: SetNull, onUpdate: Cascade)
