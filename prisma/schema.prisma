  idempotencyKey     String              @unique
  payloadHash        String              @db.Char(64)
  status             MediaRevisionStatus @default(PREPARED)
  source             String
  summary            String
  failureCode        String?
  failureDetail      Json?
  createdBy          String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  preparedAt         DateTime            @default(now())
  activatedAt        DateTime?
  supersededAt       DateTime?
  rolledBackAt       DateTime?
  verificationAt     DateTime?
  verificationResult Json?

  casino           Casino                 @relation(fields: [casinoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  affiliateOffer   AffiliateOffer?        @relation(fields: [affiliateOfferId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  previousRevision MediaRevision?         @relation("MediaRevisionHistory", fields: [previousRevisionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  nextRevisions    MediaRevision[]        @relation("MediaRevisionHistory")
  variants         MediaCreativeVariant[]
  preflight        MediaPreflightEntry[]

  @@unique([batchId, payloadHash])
  @@index([casinoId, affiliateOfferId, status, activatedAt])
  @@index([previousRevisionId])
  @@index([createdAt])
}

/// Persisted resolver decision for one market/language/device/placement cell.
model MediaPreflightEntry {
  id                 String                @id @default(uuid()) @db.Uuid
  revisionId         String                @db.Uuid
  casinoId           String                @db.Uuid
  affiliateOfferId   String?               @db.Uuid
  creativeSetId      String?               @db.Uuid
  creativeVariantId  String?               @db.Uuid
  mediaAssetId       String?               @db.Uuid
  hostedCreativeId   String?               @db.Uuid
  countryCode        String?
  languageCode       String?
  languageState      MediaLanguageState
  device             MediaPlacementVariant
  placement          MediaPlacement
  resolutionSource   String
  status             MediaPreflightStatus
  assetHash          String?               @db.Char(64)
  provider           String?
  externalCreativeId String?
  result             Json                  @default("{}")
  blockerCode        String?
  createdAt          DateTime              @default(now())

  revision        MediaRevision          @relation(fields: [revisionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  casino          Casino                 @relation(fields: [casinoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  affiliateOffer  AffiliateOffer?        @relation(fields: [affiliateOfferId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  creativeSet     MediaCreativeSet?      @relation(fields: [creativeSetId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  creativeVariant MediaCreativeVariant?  @relation(fields: [creativeVariantId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  mediaAsset      MediaAsset?            @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  hostedCreative  PartnerHostedCreative? @relation(fields: [hostedCreativeId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([revisionId, countryCode, languageCode, device, placement])
  @@index([casinoId, affiliateOfferId, status])
  @@index([creativeSetId])
  @@index([creativeVariantId])
}

model SiteSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}
