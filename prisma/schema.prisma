  renderingMode    MediaRenderingMode         @default(CONTAIN)
  cropSafe         Boolean                    @default(false)
  priority         Int                        @default(0)
  status           MediaCreativeVariantStatus @default(PREPARED)
  availability     MediaCreativeAvailability  @default(AVAILABLE)
  sourceHash       String                     @db.Char(64)
  altTextOverride  String?
