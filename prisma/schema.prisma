model AdminUser {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String?   @unique
  email     String    @unique
  name      String
  role      AdminRole @default(AUTHOR)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user                    User?                   @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  auditLogs               AuditLog[]
  activeDayCorrections    ProgrammeActiveDay[]
  commercialOpportunities CommercialOpportunity[] @relation("CommercialOpportunityOwner")
  commercialApplications  CommercialApplication[] @relation("CommercialApplicationOwner")
  commercialTasks         CommercialTask[]        @relation("CommercialTaskOwner")
  commercialActivities    CommercialActivity[]    @relation("CommercialActivityActor")
  emailCampaignsCreated   EmailCampaign[]         @relation("EmailCampaignCreatedBy")
  emailCampaignsReviewed  EmailCampaign[]         @relation("EmailCampaignReviewedBy")
}

model User {
  id                 String               @id
  name               String
  email              String               @unique
  emailVerified      Boolean              @default(false)
  image              String?
  accountState       CustomerAccountState @default(ACTIVE)
  preferredLocale    String?              @db.VarChar(16)
  signupCountryCode  String?              @db.VarChar(2)
  signupSource       String?              @db.VarChar(64)
  signupReferrerHost String?              @db.VarChar(253)
  signupUtmSource    String?              @db.VarChar(100)
  signupUtmMedium    String?              @db.VarChar(100)
  signupUtmCampaign  String?              @db.VarChar(100)
  signupUtmContent   String?              @db.VarChar(100)
  signupUtmTerm      String?              @db.VarChar(100)
  lastSeenAt         DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  sessions                           Session[]
  accounts                           Account[]
  oauthClients                       OauthClient[]
  oauthRefreshTokens                 OauthRefreshToken[]
  oauthAccessTokens                  OauthAccessToken[]
  oauthConsents                      OauthConsent[]
  adminUser                          AdminUser?
  programEnrollments                 ProgramEnrollment[]
  xpEvents                           UserXpEvent[]
  achievements                       UserAchievement[]
  consumedProgrammeClaims            PendingProgrammeClaim[]
  programmeActiveDays                ProgrammeActiveDay[]
  programmeSensitiveInputAuthorities ProgrammeSensitiveInputAuthority[]
  programmeStartingPoints            ProgrammeStartingPoint[]
  programmeAccessAcceptance          ProgrammeAccessAcceptance?
  analyticsSessions                  AnalyticsSession[]
  analyticsEvents                    AnalyticsEvent[]
  outboundClicks                     OutboundClick[]
  consentEvents                      ConsentEvent[]
  emailPreference                    CustomerEmailPreference?
  emailMessages                      EmailMessage[]
  emailUnsubscribeTokens             EmailUnsubscribeToken[]

  @@index([createdAt])
  @@index([lastSeenAt])
  @@index([accountState, createdAt])
  @@index([preferredLocale])
  @@index([signupCountryCode])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]

  @@index([userId])
}

model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([issuer, accountId], map: "account_issuer_accountId_uidx")
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// Additive Better Auth OAuth provider storage used only by the bounded
// Commercial MCP bridge. Consumer and Programme sessions remain unchanged.
model OauthClient {
  id                               String    @id
  clientId                         String    @unique
  clientSecret                     String?
  clientDiscoveryId                String?
  disabled                         Boolean?  @default(false)
  skipConsent                      Boolean?
  enableEndSession                 Boolean?
  subjectType                      String?
  scopes                           String[]
  clientCredentialsScopes          String[]  @default([])
  userId                           String?
  createdAt                        DateTime?
  updatedAt                        DateTime?
  name                             String?
  uri                              String?
  icon                             String?
  contacts                         String[]  @default([])
  tos                              String?
  policy                           String?
  softwareId                       String?
  softwareVersion                  String?
  softwareStatement                String?
  redirectUris                     String[]
  postLogoutRedirectUris           String[]  @default([])
  backchannelLogoutUri             String?
  backchannelLogoutSessionRequired Boolean?
  tokenEndpointAuthMethod          String?
  applicationType                  String?
  jwks                             String?
  jwksUri                          String?
  grantTypes                       String[]
  responseTypes                    String[]
  // Retained temporarily for Better Auth 1.6 rollback compatibility. Better
  // Auth 1.7 uses applicationType and tokenEndpointAuthMethod instead.
  public                           Boolean?
  type                             String?
  requirePKCE                      Boolean?
  dpopBoundAccessTokens            Boolean?  @default(false)
  referenceId                      String?
  metadata                         Json?

  user          User?                 @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  resources     OauthClientResource[]
  refreshTokens OauthRefreshToken[]
  accessTokens  OauthAccessToken[]
  consents      OauthConsent[]

  @@index([userId])
  @@map("oauthClient")
}

model OauthResource {
  id                            String    @id
  identifier                    String    @unique
  name                          String
  accessTokenTtl                Int?
  refreshTokenTtl               Int?
  signingAlgorithm              String?
  signingKeyId                  String?
  allowedScopes                 String[]
  customClaims                  Json?
  dpopBoundAccessTokensRequired Boolean?  @default(false)
  disabled                      Boolean?  @default(false)
  createdAt                     DateTime?
  updatedAt                     DateTime?
  policyVersion                 Int?      @default(1)
  metadata                      Json?

  clients OauthClientResource[]

  @@map("oauthResource")
}

model OauthClientResource {
  id         String    @id
  clientId   String
  resourceId String
  metadata   Json?
  createdAt  DateTime?

  client   OauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade, onUpdate: Cascade)
  resource OauthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade, onUpdate: Cascade)

  @@unique([clientId, resourceId], map: "oauthClientResource_clientId_resourceId_uidx")
  @@index([clientId])
  @@index([resourceId])
  @@map("oauthClientResource")
}

model OauthRefreshToken {
  id                      String    @id
  token                   String    @unique
  clientId                String
  sessionId               String?
  userId                  String
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]
  requestedUserInfoClaims String[]  @default([])
  expiresAt               DateTime
  createdAt               DateTime
  revoked                 DateTime?
  rotatedAt               DateTime?
  rotationReplayResponse  String?
  rotationReplayExpiresAt DateTime?
  authTime                DateTime?
  confirmation            Json?
  scopes                  String[]

  client       OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade, onUpdate: Cascade)
  session      Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  accessTokens OauthAccessToken[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@map("oauthRefreshToken")
}

model OauthAccessToken {
  id                      String    @id
  token                   String    @unique
  clientId                String
  sessionId               String?
  userId                  String?
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]
  requestedUserInfoClaims String[]  @default([])
  refreshId               String?
  expiresAt               DateTime
  createdAt               DateTime
  revoked                 DateTime?
  confirmation            Json?
  scopes                  String[]

  client       OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade, onUpdate: Cascade)
  session      Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  user         User?              @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  refreshToken OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@index([refreshId])
  @@map("oauthAccessToken")
}

model OauthConsent {
  id                      String   @id
  clientId                String
  userId                  String?
  referenceId             String?
  resources               String[]
  requestedUserInfoClaims String[] @default([])
  scopes                  String[]
  createdAt               DateTime
  updatedAt               DateTime

  client OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade, onUpdate: Cascade)
  user   User?       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([clientId])
  @@index([userId])
  @@map("oauthConsent")
}

model OauthClientAssertion {
  id        String   @id
  expiresAt DateTime

  @@map("oauthClientAssertion")
}

// Hashed fixed-window counters for the public Commercial MCP boundary. Raw IP,
// staff and OAuth client identifiers are never stored in this table.
model CommercialMcpRateLimitBucket {
  bucketKey       String   @id
  scope           String
  count           Int
  windowStartedAt DateTime
  expiresAt       DateTime

  @@index([expiresAt])
}

model Program {
  id                           String          @id @default(uuid()) @db.Uuid
  slug                         String          @unique
  internalName                 String
  title                        String
  summary                      String
  introduction                 String
  estimatedTotalMinutes        Int
  language                     String          @default("en")
  difficulty                   String          @default("Beginner")
  coverImage                   String?
  xpCompletionReward           Int             @default(0)
  certificateEnabled           Boolean         @default(false)
  registrationRequirementPoint String          @default("NEVER")
  progressSavingBehavior       String          @default("LOCAL")
  completionRules              Json
