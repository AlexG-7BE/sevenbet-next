  entityType String
  entityId   String
  summary    String
  metadata   Json?
  timestamp  DateTime @default(now())

  actor AdminUser @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([timestamp])
}

model MediaAsset {
  id               String               @id @default(uuid()) @db.Uuid
  type             MediaAssetType       @default(OTHER)
  storageProvider  MediaStorageProvider @default(LOCAL)
  storageKey       String               @unique
  publicUrl        String               @map("url")
  originalFilename String
  mimeType         String
  width            Int?
  height           Int?
  sizeBytes        Int
  altText          String               @map("alt")
  title            String?
  caption          String?
  credit           String?
  sortOrder        Int                  @default(0)
  featured         Boolean              @default(false)
  status           MediaAssetStatus     @default(ACTIVE)
  checksum         String?
  metadata         Json?
  variants         Json?
  createdBy        String
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  archivedAt       DateTime?
  casinoId         String?              @db.Uuid
  casinoBonusId    String?              @db.Uuid
  affiliateOfferId String?              @db.Uuid

  casino         Casino?         @relation(fields: [casinoId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  casinoBonus    CasinoBonus?    @relation(fields: [casinoBonusId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  affiliateOffer AffiliateOffer? @relation(fields: [affiliateOfferId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([casinoId, type, status, sortOrder])
  @@index([casinoBonusId, type, status])
  @@index([affiliateOfferId, type, status])
  @@index([checksum])
  @@index([status, updatedAt])
}

model SiteSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}
