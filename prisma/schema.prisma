  @@index([normalizedName])
  @@index([operatorId])
  @@index([brandId])
  @@index([casinoId])
  @@index([affiliateNetworkId])
  @@index([affiliateProgramId])
  @@index([possibleDuplicateOfId])
}

model CommercialEvidence {
