  scenarioCheckCompletedAt DateTime
  meaningCheckCompletedAt  DateTime
  earlySignalCategory      EarlySignalCategory?
  earlySignalText          String?
  notNow                   Boolean              @default(false)
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  deletedAt                DateTime?

  enrollment        ProgramEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  sourcedBoundaries ActiveBoundary[]
}

/// Private Mission 04 rule. User-entered values and free text remain inside
/// the Programme aggregate and never enter commercial ranking or targeting.
model ActiveBoundary {
  id                         String           @id @default(uuid()) @db.Uuid
  enrollmentId               String           @unique @db.Uuid
  sourceCurrentGoalId        String?          @db.Uuid
  sourceUrgeLearningRecordId String?          @db.Uuid
  missionVersion             String
  evidenceVersion            String
  category                   BoundaryCategory
  triggerType                String
  triggerText                String?
  ruleText                   String
  limitValue                 Decimal?         @db.Decimal(12, 2)
  limitUnit                  String?
  limitPeriod                String?
  executionMethod            String
  executionDetail            String?
  copingAction               String
  reviewAt                   DateTime
  status                     BoundaryStatus   @default(ACTIVE)
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt
  deletedAt                  DateTime?

  enrollment               ProgramEnrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  sourceCurrentGoal        CurrentGoal?        @relation(fields: [sourceCurrentGoalId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  sourceUrgeLearningRecord UrgeLearningRecord? @relation(fields: [sourceUrgeLearningRecordId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([sourceCurrentGoalId])
  @@index([sourceUrgeLearningRecordId])
}

/// The closed, user-confirmed PROGRAM-AI Mission 01 result. Candidate text,
