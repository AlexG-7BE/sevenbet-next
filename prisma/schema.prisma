  marketProfile       CasinoCountry?           @relation(fields: [marketProfileId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  affiliateOffer      AffiliateOffer?          @relation(fields: [affiliateOfferId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  primaryTrackingLink AffiliateTrackingLink?   @relation(fields: [primaryTrackingLinkId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  redirectSlug        AffiliateRedirectSlug?   @relation(fields: [redirectSlugId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  casinoBonus         CasinoBonus?             @relation(fields: [casinoBonusId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  intents             MarketActivationIntent[]
  events              MarketActivationEvent[]

  @@unique([casinoId, marketCode, product])
  @@unique([redirectSlugId, marketCode, product])
  @@unique([primaryTrackingLinkId, marketCode, product])
  @@index([marketCode, product, status])
  @@index([countryCode, product, status])
  @@index([desiredState, status, updatedAt])
  @@index([routeVerificationStatus, routeLastCheckedAt])
  @@index([marketProfileId])
  @@index([affiliateOfferId])
  @@index([casinoBonusId])
}

/// Positive operator-market support asserted for one already-established
/// Partner × Casino relationship. CasinoCountry remains factual availability,
/// legal authority remains independent, and MarketActivation remains the only
/// Production commercial authority.
model PartnerCasinoMarketSupport {
  id                      String                         @id @default(uuid()) @db.Uuid
  opportunityId           String                         @db.Uuid
  affiliateNetworkId      String                         @db.Uuid
  casinoId                String                         @db.Uuid
  casinoCountryId         String                         @db.Uuid
  countryCode             String                         @db.Char(2)
  marketCode              String                         @db.VarChar(16)
  operatorMarketSupported Boolean                        @default(true)
  sourceType              CasinoMarketEvidenceSourceType @default(INTERNAL_RECORD)
  sourceReference         String
  observedAt              DateTime
  lastVerifiedAt          DateTime
  createdBy               String
  createdAt               DateTime                       @default(now())
  updatedAt               DateTime                       @updatedAt

  opportunity      CommercialOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  affiliateNetwork AffiliateNetwork      @relation(fields: [affiliateNetworkId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  casino           Casino                @relation(fields: [casinoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  marketProfile    CasinoCountry         @relation(fields: [casinoCountryId, casinoId, countryCode], references: [id, casinoId, countryCode], onDelete: Restrict, onUpdate: Cascade)

  @@unique([opportunityId, casinoId, marketCode])
  @@index([affiliateNetworkId, casinoId, marketCode])
  @@index([casinoCountryId])
  @@index([marketCode, operatorMarketSupported])
}

model MarketActivationIntent {
  id               String                       @id @default(uuid()) @db.Uuid
  activationId     String                       @db.Uuid
  idempotencyKey   String                       @unique
  desiredState     MarketActivationDesiredState
  origin           MarketActivationIntentOrigin
  actorId          String
  reason           String
  sourceReferences String[]                     @default([])
  payloadHash      String
  createdAt        DateTime                     @default(now())

  activation MarketActivation        @relation(fields: [activationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  events     MarketActivationEvent[]

  @@index([activationId, createdAt])
  @@index([origin, createdAt])
}

model MarketActivationEvent {
  id                   String                        @id @default(uuid()) @db.Uuid
  activationId         String                        @db.Uuid
  intentId             String?                       @db.Uuid
  sequence             Int
  type                 MarketActivationEventType
  previousDesiredState MarketActivationDesiredState?
  previousStatus       MarketActivationStatus?
  desiredState         MarketActivationDesiredState
  status               MarketActivationStatus
  actorId              String
  origin               MarketActivationIntentOrigin
  reason               String
  controllerVersion    String
  metadata             Json                          @default("{}")
  occurredAt           DateTime                      @default(now())

  activation MarketActivation        @relation(fields: [activationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  intent     MarketActivationIntent? @relation(fields: [intentId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([activationId, sequence])
  @@index([activationId, occurredAt])
  @@index([type, occurredAt])
  @@index([intentId])
}

/// One consented logical browsing session. Browser identifiers are opaque,
/// first-party and never authentication or commercial-routing authority.
model AnalyticsSession {
  id                String                  @id @db.Uuid
  anonymousId       String                  @db.Uuid
  userId            String?
  environment       AnalyticsEnvironment
  trafficKind       AnalyticsTrafficKind    @default(HUMAN)
  startedAt         DateTime
  lastActivityAt    DateTime
  expiresAt         DateTime
  landingPath       String?                 @db.VarChar(512)
  locale            String?                 @db.VarChar(16)
  countryCode       String?                 @db.Char(2)
  referrerHost      String?                 @db.VarChar(253)
  acquisitionSource String?                 @db.VarChar(64)
  utmSource         String?                 @db.VarChar(100)
  utmMedium         String?                 @db.VarChar(100)
  utmCampaign       String?                 @db.VarChar(100)
  utmContent        String?                 @db.VarChar(100)
  utmTerm           String?                 @db.VarChar(100)
  deviceCategory    AnalyticsDeviceCategory @default(UNKNOWN)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  user           User?            @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  events         AnalyticsEvent[]
  outboundClicks OutboundClick[]

  @@index([anonymousId, startedAt])
  @@index([userId, startedAt])
  @@index([environment, trafficKind, startedAt])
  @@index([expiresAt])
}

/// Closed-schema Product Core event. Dimensions are explicit by design; this
/// model must not grow an arbitrary event-properties JSON column.
model AnalyticsEvent {
  id                 String                  @id @db.Uuid
  dedupeKey          String                  @unique @db.VarChar(200)
  schemaVersion      Int                     @default(1)
  type               AnalyticsEventType
  environment        AnalyticsEnvironment
  trafficKind        AnalyticsTrafficKind    @default(HUMAN)
  occurredAt         DateTime
  receivedAt         DateTime                @default(now())
  anonymousId        String?                 @db.Uuid
  analyticsSessionId String?                 @db.Uuid
  userId             String?
  pagePath           String?                 @db.VarChar(512)
  locale             String?                 @db.VarChar(16)
  countryCode        String?                 @db.Char(2)
  referrerHost       String?                 @db.VarChar(253)
  acquisitionSource  String?                 @db.VarChar(64)
  utmSource          String?                 @db.VarChar(100)
  utmMedium          String?                 @db.VarChar(100)
  utmCampaign        String?                 @db.VarChar(100)
  utmContent         String?                 @db.VarChar(100)
  utmTerm            String?                 @db.VarChar(100)
  deviceCategory     AnalyticsDeviceCategory @default(UNKNOWN)
  casinoId           String?                 @db.Uuid
  affiliateOfferId   String?                 @db.Uuid
  affiliateNetworkId String?                 @db.Uuid
  placement          String?                 @db.VarChar(64)
  position           Int?
  programmeStep      Int?
  outboundClickId    String?                 @db.Uuid
  emailMessageId     String?                 @db.Uuid
  createdAt          DateTime                @default(now())

  session          AnalyticsSession? @relation(fields: [analyticsSessionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  casino           Casino?           @relation(fields: [casinoId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  affiliateOffer   AffiliateOffer?   @relation(fields: [affiliateOfferId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  affiliateNetwork AffiliateNetwork? @relation(fields: [affiliateNetworkId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  outboundClick    OutboundClick?    @relation(fields: [outboundClickId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  emailMessage     EmailMessage?     @relation(fields: [emailMessageId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([environment, trafficKind, occurredAt])
  @@index([environment, type, occurredAt])
  @@index([occurredAt])
  @@index([userId, occurredAt])
  @@index([analyticsSessionId, occurredAt])
  @@index([anonymousId, occurredAt])
  @@index([casinoId, occurredAt])
  @@index([affiliateOfferId, occurredAt])
  @@index([countryCode, occurredAt])
  @@index([pagePath, occurredAt])
  @@index([outboundClickId])
  @@index([emailMessageId])
}

/// Final server-authoritative observation of one controlled /r/{slug}
/// attempt. Destination and tracking URLs are intentionally absent.
model OutboundClick {
  id                 String               @id @db.Uuid
  state              OutboundClickState
  blockedReason      String?              @db.VarChar(64)
  environment        AnalyticsEnvironment
  trafficKind        AnalyticsTrafficKind @default(HUMAN)
  attemptedAt        DateTime
  resolvedAt         DateTime
  anonymousId        String?              @db.Uuid
  analyticsSessionId String?              @db.Uuid
  userId             String?
  sourcePage         String?              @db.VarChar(512)
  locale             String?              @db.VarChar(16)
  countryCode        String?              @db.Char(2)
  acquisitionSource  String?              @db.VarChar(64)
  placement          String?              @db.VarChar(64)
  requestedSlug      String               @db.VarChar(80)
  casinoId           String?              @db.Uuid
  affiliateOfferId   String?              @db.Uuid
  affiliateNetworkId String?              @db.Uuid
  redirectSlugId     String?              @db.Uuid
  trackingLinkId     String?              @db.Uuid
  createdAt          DateTime             @default(now())

  session          AnalyticsSession?      @relation(fields: [analyticsSessionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  user             User?                  @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  casino           Casino?                @relation(fields: [casinoId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  affiliateOffer   AffiliateOffer?        @relation(fields: [affiliateOfferId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  affiliateNetwork AffiliateNetwork?      @relation(fields: [affiliateNetworkId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  redirectSlug     AffiliateRedirectSlug? @relation(fields: [redirectSlugId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  trackingLink     AffiliateTrackingLink? @relation(fields: [trackingLinkId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  events           AnalyticsEvent[]

  @@index([environment, trafficKind, attemptedAt])
  @@index([state, attemptedAt])
  @@index([attemptedAt])
  @@index([userId, attemptedAt])
  @@index([analyticsSessionId, attemptedAt])
  @@index([casinoId, attemptedAt])
  @@index([affiliateOfferId, attemptedAt])
  @@index([countryCode, attemptedAt])
  @@index([sourcePage, attemptedAt])
}

/// Current email send authority. Append-only ConsentEvent rows preserve the
/// material change history without making every send query replay the ledger.
model CustomerEmailPreference {
  id                String                @id @default(uuid()) @db.Uuid
  userId            String                @unique
  marketingAllowed  Boolean               @default(false)
  consentedAt       DateTime?
  unsubscribedAt    DateTime?
  suppressedAt      DateTime?
  suppressionScope  EmailSuppressionScope @default(NONE)
  suppressionReason String?               @db.VarChar(64)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([marketingAllowed, suppressionScope])
  @@index([unsubscribedAt])
}

model ConsentEvent {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String?
  anonymousId   String?        @db.Uuid
  purpose       ConsentPurpose
  action        ConsentAction
  source        ConsentSource
  policyVersion String?        @db.VarChar(64)
  locale        String?        @db.VarChar(16)
  occurredAt    DateTime
  createdAt     DateTime       @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, purpose, occurredAt])
  @@index([userId, occurredAt])
  @@index([anonymousId, purpose, occurredAt])
  @@index([purpose, action, occurredAt])
}

model EmailTemplate {
  id        String            @id @default(uuid()) @db.Uuid
  key       EmailTemplateKey
  type      EmailTemplateType
  locale    String            @db.VarChar(16)
  subject   String            @db.VarChar(200)
  htmlBody  String
  textBody  String
  version   Int               @default(1)
  active    Boolean           @default(false)
  createdBy String            @db.VarChar(100)
  updatedBy String            @db.VarChar(100)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  messages  EmailMessage[]
  campaigns EmailCampaign[]

  @@unique([key, locale, version])
  @@index([key, locale, active])
  @@index([type, active])
}

model EmailCampaign {
  id                       String                @id @default(uuid()) @db.Uuid
  environment              AnalyticsEnvironment
  name                     String                @db.VarChar(160)
  templateId               String                @db.Uuid
  locale                   String?               @db.VarChar(16)
  countryCode              String?               @db.Char(2)
  programmeSegment         EmailProgrammeSegment @default(ANY)
  inactiveDays             Int?
  newUsersOnly             Boolean               @default(false)
  status                   EmailCampaignStatus   @default(DRAFT)
  idempotencyKey           String                @db.VarChar(200)
  estimatedEligibleCount   Int                   @default(0)
  estimatedExcludedCount   Int                   @default(0)
  estimatedSuppressedCount Int                   @default(0)
  queuedCount              Int                   @default(0)
  sentCount                Int                   @default(0)
  failedCount              Int                   @default(0)
  createdByAdminId         String                @db.Uuid
  reviewedByAdminId        String?               @db.Uuid
  reviewedAt               DateTime?
  queuedAt                 DateTime?
  completedAt              DateTime?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  template   EmailTemplate  @relation(fields: [templateId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy  AdminUser      @relation("EmailCampaignCreatedBy", fields: [createdByAdminId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reviewedBy AdminUser?     @relation("EmailCampaignReviewedBy", fields: [reviewedByAdminId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  messages   EmailMessage[]

  @@unique([environment, idempotencyKey])
  @@index([environment, status, createdAt])
  @@index([templateId, createdAt])
  @@index([createdByAdminId, createdAt])
}

model EmailMessage {
  id                String               @id @default(uuid()) @db.Uuid
  userId            String
  campaignId        String?              @db.Uuid
  templateId        String               @db.Uuid
  purpose           EmailPurpose
  status            EmailMessageStatus   @default(QUEUED)
  environment       AnalyticsEnvironment
  locale            String               @db.VarChar(16)
  recipientEmail    String
  subject           String               @db.VarChar(200)
  templateVersion   Int
  idempotencyKey    String               @db.VarChar(200)
  provider          String?              @db.VarChar(32)
  providerMessageId String?              @unique @db.VarChar(200)
  attemptCount      Int                  @default(0)
  queuedAt          DateTime             @default(now())
  lastAttemptAt     DateTime?
  nextAttemptAt     DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  bouncedAt         DateTime?
  clickedAt         DateTime?
  unsubscribedAt    DateTime?
  failedAt          DateTime?
  deliveryErrorCode String?              @db.VarChar(64)
  isTest            Boolean              @default(false)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  campaign         EmailCampaign?         @relation(fields: [campaignId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  template         EmailTemplate          @relation(fields: [templateId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  providerEvents   EmailProviderEvent[]
  unsubscribeToken EmailUnsubscribeToken?
  analyticsEvents  AnalyticsEvent[]

  @@unique([campaignId, userId])
  @@unique([environment, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, nextAttemptAt, queuedAt])
  @@index([purpose, createdAt])
  @@index([environment, status, createdAt])
  @@index([environment, sentAt])
  @@index([status, createdAt])
  @@index([campaignId, status])
}

model EmailProviderEvent {
  id                String                 @id @default(uuid()) @db.Uuid
  providerEventId   String                 @unique @db.VarChar(200)
  messageId         String                 @db.Uuid
  providerMessageId String                 @db.VarChar(200)
  type              EmailProviderEventType
  occurredAt        DateTime
  receivedAt        DateTime               @default(now())
  createdAt         DateTime               @default(now())

  message EmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([messageId, occurredAt])
  @@index([type, occurredAt])
  @@index([occurredAt])
  @@index([providerMessageId])
}

model EmailUnsubscribeToken {
  id         String    @id @default(uuid()) @db.Uuid
  messageId  String    @unique @db.Uuid
  userId     String
  tokenHash  String    @unique @db.Char(64)
  createdAt  DateTime  @default(now())
  consumedAt DateTime?

  message EmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, consumedAt])
}

/// One-way transient abuse counter. bucketKey is a purpose-separated HMAC and
/// cannot be reversed to a request IP or customer identity.
model AnalyticsRateLimitBucket {
  bucketKey       String   @id @db.Char(64)
  count           Int
  windowStartedAt DateTime
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([expiresAt])
}

/// First-party aggregate commercial measurement. Each row is a UTC-day
/// counter for one exact Casino × GEO × route × tracking-link identity. It
/// deliberately contains no visitor, account, session, IP, user-agent,
/// referrer, query-string, Programme, pause, or Help data.
model AffiliateOutboundClickDaily {
  id               String   @id @default(uuid()) @db.Uuid
  day              DateTime @db.Date
  casinoId         String   @db.Uuid
  countryCode      String
  redirectSlugId   String   @db.Uuid
  affiliateOfferId String   @db.Uuid
  trackingLinkId   String   @db.Uuid
  clickCount       Int      @default(0)
  lastClickedAt    DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  casino       Casino                @relation(fields: [casinoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  redirectSlug AffiliateRedirectSlug @relation(fields: [redirectSlugId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  offer        AffiliateOffer        @relation(fields: [affiliateOfferId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  trackingLink AffiliateTrackingLink @relation(fields: [trackingLinkId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([day, casinoId, countryCode, redirectSlugId, trackingLinkId], map: "AffiliateOutboundClickDaily_identity_key")
  @@index([day, countryCode])
  @@index([casinoId, day])
  @@index([redirectSlugId, day])
  @@index([affiliateOfferId, day])
}

model CasinoSeo {
